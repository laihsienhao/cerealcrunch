__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store

# Datasets are large and rebuildable from data/README.md - never commit them.
data/raw/*
!data/raw/.gitkeep

# Checkpoints are large binaries, rebuildable via scripts/train.py.
models/checkpoints/*
!models/checkpoints/.gitkeep

# Eval outputs are regenerable via scripts/evaluate.py.
outputs/eval/*
!outputs/eval/.gitkeep

# Error-analysis outputs are regenerable via scripts/error_analysis.py.
outputs/error_analysis/*
!outputs/error_analysis/.gitkeep
